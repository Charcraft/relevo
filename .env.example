# Entorno de ejemplo para Relevo Backend (copia a .env y completa con tus valores)

# --- Rutas locales ---
RELEVO_DATA=./data
RELEVO_VAULT=./vault-demo
RELEVO_WORK=./work
RELEVO_WEB_DIR=../web
RELEVO_PANEL_DIR=../panel
RELEVO_AUTH_FILE=./data/panel-auth.json

# --- Red y puertos ---
PANEL_BIND=127.0.0.1
PANEL_PORT=8787
PANEL_PUBLIC_PORT=8789
TRACK_PORT=8788
TZ=America/Mexico_City

# --- URLs públicas (para enlaces de integración y CORS del rastreador /t) ---
RELEVO_PUBLIC_BASE_URL=http://127.0.0.1:8789
RELEVO_BACKUP_BASE_URL=
RELEVO_PANEL_URL=http://127.0.0.1:8787/panel/
RELEVO_NOVNC_URL=http://127.0.0.1:7907/vnc.html
TRACK_ORIGINS=http://127.0.0.1:8787,http://localhost:8787,http://127.0.0.1:8789,http://localhost:4321

# --- Canales opcionales (solo necesarios si usas `npm start` completo) ---
TELEGRAM_BOT_TOKEN=
OWNER_PAIR_CODE=
OWNER_WA_ID=

# --- Proveedores LLM opcionales ---
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
CHROME_PATH=/usr/bin/google-chrome
